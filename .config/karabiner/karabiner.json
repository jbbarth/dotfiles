{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Zen: Cmd+Option+Left/Right = prev/next tab, Cmd+Option+Up/Down = prev/next workspace (swap)",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^app\\.zen-browser\\.zen$"
                                        ],
                                        "type": "frontmost_application_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "left_arrow",
                                    "modifiers": { "mandatory": ["command", "option"] }
                                },
                                "to": [
                                    {
                                        "key_code": "up_arrow",
                                        "modifiers": ["left_command", "left_option"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
